OPENAI_API_KEY=replace_with_your_openai_api_key
# Public guest workspaces are the Render default; set false for a private installation
# PUBLIC_ACCESS=true
# For a private installation, require this password at sign-in
# APP_PASSWORD=replace_with_a_private_workspace_password
# Required on Render: connect a Postgres database through DATABASE_URL
# DATABASE_URL=postgresql://user:password@host/database
# Required on Render unless APP_PASSWORD is set; signs guest browser cookies
# SESSION_SECRET=replace_with_a_long_random_value
